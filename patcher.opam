opam-version: "2.0"
synopsis: "Browser-based FireRed and LeafGreen ROM patcher"
description: "An OCaml browser application that validates supported ROM revisions and applies verified BPS patches locally"
maintainer: "James Karlsson"
authors: "James Karlsson"
depends: [
  "ocaml" {>= "5.2.0" & < "5.5.0"}
  "dune" {>= "3.20" & < "4.0"}
  "js_of_ocaml" {>= "6.4.0" & < "7.0.0"}
  "js_of_ocaml-compiler" {>= "6.4.0" & < "7.0.0"}
  "js_of_ocaml-ppx" {>= "6.4.0" & < "7.0.0"}
]

